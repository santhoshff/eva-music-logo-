{
  "name": "eva-music-workspace",
  "private": true,
  "workspaces": [
    "eva-music-app",
    "eva-music-backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=eva-music-backend",
    "dev:frontend": "npm run dev --workspace=eva-music-app",
    "build:backend": "npm run build --workspace=eva-music-backend",
    "build:frontend": "npm run build --workspace=eva-music-app",
    "lint:frontend": "npm run lint --workspace=eva-music-app"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.25.12",
    "@rollup/rollup-linux-x64-gnu": "^4.62.2",
    "@rollup/rollup-linux-x64-musl": "^4.62.2",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "^4.3.3",
    "lightningcss-linux-x64-gnu": "^1.32.0",
    "lightningcss-linux-x64-musl": "^1.32.0"
  }
}
